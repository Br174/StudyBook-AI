{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LAB124 — Auto-compila APK+ZIP all'apertura Codespaces (senza Actions)",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/codespaces-lab124-autobuild.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    }
  ]
}
