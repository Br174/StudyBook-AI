{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LAB142 — Compilazione APK+ZIP (Codespaces, manuale)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/codespaces-lab142-autobuild.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "LAB142 — Test EPUB e unica versione al 50% (senza deploy)",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "test:lab142"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    }
  ]
}
