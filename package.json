{
  "name": "studybook-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/test-posthog-config.mjs && node scripts/test-posthog-pilot-probe.mjs && node scripts/test-posthog-root-integration.mjs && node scripts/test-cloudflare-contract.mjs && node scripts/test-cloudflare-preview-workflow.mjs && vite build",
    "preview": "vite preview",
    "dev:cloudflare": "npm run build && wrangler dev",
    "test:cloudflare": "node --test scripts/test-cloudflare-worker.mjs",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run && npm run test:cloudflare",
    "preview:cloudflare": "npm run build && wrangler preview ./worker/index.js",
    "test:fidelity": "node scripts/test-fidelity-engine.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:add": "npm run build && npx cap add android"
  },
  "dependencies": {
    "@posthog/react": "^1.11.3",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.3.289",
    "posthog-js": "^1.435.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.2",
    "@capacitor/file-viewer": "2.0.4",
    "@capacitor-community/text-to-speech": "8.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.0.0",
    "vite": "^7.1.5",
    "wrangler": "4.135.0",
    "@capacitor/cli": "8.5.2"
  }
}
