{
  "name": "studybook-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/apply-cancel-feature.mjs && vite build",
    "preview": "vite preview",
    "dev:cloudflare": "npm run build && wrangler dev",
    "test:cloudflare": "node --test scripts/test-cloudflare-worker.mjs",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run && npm run test:cloudflare",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.5",
    "wrangler": "4.131.2"
  }
}
